APP_NAME="e-Rapor Sekolah"
APP_VERSION="Laravel 13"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erapor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

VITE_APP_NAME="${APP_NAME}"
# Opsional: isi sebelum menjalankan db:seed untuk membuat akun Ketua Yayasan pertama
SUPER_ADMIN_NAME=Ketua Yayasan
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
